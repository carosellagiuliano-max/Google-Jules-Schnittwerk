# -------------------------------------
# Database
# -------------------------------------
# The connection string for your PostgreSQL database.
# For local development, you can use a Docker container.
# For production, use the connection string provided by your database host (e.g., Supabase).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_app"

# -------------------------------------
# Supabase (for Auth)
# -------------------------------------
# These can be found in your Supabase project's API settings.
# Public keys are safe to be exposed in the browser.
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# The service role key should be kept secret and only used on the server.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# -------------------------------------
# JWT Secret
# -------------------------------------
# A secret key for signing JWTs. Used for Supabase Auth.
# You can generate a secure secret with: openssl rand -hex 32
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"
