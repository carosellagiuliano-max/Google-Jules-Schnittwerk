datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  plan      String   @default("basic")
  themeJson Json?
  createdAt DateTime @default(now()) @map("created_at")
  profiles  Profile[]
  services  Service[]
  staff     Staff[]
  bookings  Booking[]
  bans      CustomerBan[]
  schedules StaffSchedule[]
  timeOffs  StaffTimeOff[]
}

model Profile {
  id        String    @id
  email     String
  role      String
  tenantId  String    @db.Uuid
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  fullName  String?
  phone     String?
  createdAt DateTime  @default(now()) @map("created_at")
  bookings  Booking[] @relation("CustomerBookings")
  createdBookings Booking[] @relation("CreatedBy")
  cancelledBookings Booking[] @relation("CancelledBy")

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("profile")
}

model Service {
  id          String   @id @default(cuid())
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  durationMin Int      // Duration in minutes
  priceCents  Int      // Price in the smallest currency unit (e.g., cents)
  active      Boolean  @default(true)
  bookings    Booking[]

  @@unique([tenantId, name])
  @@map("service")
}

model Staff {
  id        String          @id @default(cuid())
  tenantId  String          @db.Uuid
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  name      String
  active    Boolean         @default(true)
  schedules StaffSchedule[]
  timeOffs  StaffTimeOff[]
  bookings  Booking[]

  @@unique([tenantId, name])
  @@map("staff")
}

model StaffSchedule {
  id        String   @id @default(cuid())
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  weekday   Int
  startMin  Int
  endMin    Int

  @@unique([tenantId, staffId, weekday])
  @@map("staff_schedule")
}

model StaffTimeOff {
  id        String   @id @default(cuid())
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id])
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  reason    String?

  @@map("staff_time_off")
}

model Booking {
  id                String   @id @default(cuid())
  tenantId          String   @db.Uuid
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  serviceId         String
  service           Service  @relation(fields: [serviceId], references: [id])
  staffId           String
  staff             Staff    @relation(fields: [staffId], references: [id])
  customerId        String?
  customer          Profile? @relation("CustomerBookings", fields: [customerId], references: [id])
  startAt           DateTime @map("start_at")
  endAt             DateTime @map("end_at")
  status            String
  customerName      String
  email             String?
  phone             String?
  createdAt         DateTime @default(now()) @map("created_at")
  createdByUserId   String?
  createdByUser     Profile? @relation("CreatedBy", fields: [createdByUserId], references: [id])
  cancelledByUserId String?
  cancelledByUser   Profile? @relation("CancelledBy", fields: [cancelledByUserId], references: [id])

  @@index([tenantId, staffId, startAt])
  @@map("booking")
}

model CustomerBan {
  id        String   @id @default(cuid())
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, email], name: "ban_by_tenant_email")
  @@map("customer_ban")
}
